lines(newdfc$amount, newdfc$lwr, col = "red", lty = 2)
lines(newdfc$amount, newdfc$upr, col = "red", lty = 2)
# Add prediction band (dashed blue)
lines(newdfp$amount, newdfp$lwr, col = "blue", lty = 2)
lines(newdfp$amount, newdfp$upr, col = "blue", lty = 2)
legend("topleft",
legend = c("Data", "Fitted line", "95% Confidence band", "95% Prediction band"),
pch = c(19, NA, NA, NA),
lty = c(NA, 1, 2, 2),
col = c("gray30", "black", "red", "blue"),
bty = "n", lwd = c(NA, 2, 1, 1))
