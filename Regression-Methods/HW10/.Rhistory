###########################################################
# HW10.R
# Logistic regression on p13_7modified.csv
# y  = binary response (0 = no fractures, 1 = 1+ fractures)
# x1, x2, x3, x4 = predictors
###########################################################
# ---- Packages ----
library(faraway)
library(lmtest)
library(epiDisplay)
install.packages("epiDisplay", dependencies = TRUE)
###########################################################
# HW10.R
# Logistic regression on p13_7modified.csv
# y  = binary response (0 = no fractures, 1 = 1+ fractures)
# x1, x2, x3, x4 = predictors
###########################################################
# ---- Packages ----
library(faraway)
library(lmtest)
library(epiDisplay)
# ---- Read Data ----
# Make sure your working directory contains p13_7modified.csv
setwd("C:/Users/RAJ RUTGERS/Desktop/Regression Methods/HW10")
dat <- read.csv("p13_7modified.csv")
str(dat)
# y should be 0/1; glm(binomial) accepts numeric 0/1
# If you prefer as a factor, you could also do:
# dat$y <- factor(dat$y, levels = c(0, 1))
###########################################################
# (a) Fit a multiple logistic regression model
###########################################################
fit.full <- glm(y ~ x1 + x2 + x3 + x4,
family = binomial(link = "logit"),
data   = dat)
summary(fit.full)
###########################################################
# (b) Likelihood ratio test
# H0: all Beta parameters (for x1–x4) are 0
# Ha: at least one Beta ≠ 0
###########################################################
# Null model with intercept only
fit.null <- glm(y ~ 1,
family = binomial(link = "logit"),
data   = dat)
# Likelihood ratio test using lmtest::lrtest
lrt.result <- lrtest(fit.null, fit.full)
print(lrt.result)
###########################################################
# (c) Plot observed y vs estimated probabilities
###########################################################
# Estimated probabilities of y = 1
phat <- fitted(fit.full)
# Simple plot: x = estimated probabilities, y = observed y
plot(phat,
jitter(dat$y, amount = 0.05),  # jitter so points don't overlap
xlab = "Estimated P(y = 1 | x)",
ylab = "Observed response y (0 = no fractures, 1 = ≥1 fracture)",
main = "Observed y vs. Estimated Probabilities",
pch  = 19)
abline(h = 0:1, lty = 2, col = "gray")
###########################################################
# (d) logistic.display output for each predictor
###########################################################
logistic.display(fit.full)
###########################################################
# HW10.R
# Logistic regression on p13_7modified.csv
# Saves results + interpretation to HW10_output.txt
# Saves plot as HW10_plot.png
###########################################################
# ---- Packages ----
library(faraway)
library(lmtest)
library(epiDisplay)
# ---- Read Data ----
setwd("C:/Users/RAJ RUTGERS/Desktop/Regression Methods/HW10")
dat <- read.csv("p13_7modified.csv")
# Open TXT output file
sink("HW10_output.txt")
cat("===== HW10 Logistic Regression Output =====\n\n")
###########################################################
# (a) Fit a multiple logistic regression model
###########################################################
fit.full <- glm(y ~ x1 + x2 + x3 + x4,
family = binomial(link = "logit"),
data   = dat)
cat("=== (a) Logistic Regression Model Summary ===\n")
print(summary(fit.full))
cat("\n--- Interpretation for (a) ---\n")
cat("• x2 is statistically significant (p = 0.019).\n")
cat("• x1, x3, and x4 are NOT significant predictors (p > 0.05).\n")
cat("• AIC = 24.036, showing a strong-fitting model.\n")
cat("• The negative intercept indicates low baseline fracture risk.\n\n")
###########################################################
# (b) Likelihood ratio test
###########################################################
fit.null <- glm(y ~ 1, family = binomial(link = "logit"), data = dat)
lrt.result <- lrtest(fit.null, fit.full)
cat("=== (b) Likelihood Ratio Test ===\n")
print(lrt.result)
cat("\n--- Interpretation for (b) ---\n")
cat("• LR Test Chi-square = 33.13 with df = 4.\n")
cat("• p-value = 1.12e-06 (HIGHLY significant).\n")
cat("• Reject H0: At least one Beta parameter is non-zero.\n")
cat("• The full model fits MUCH better than the intercept-only model.\n\n")
###########################################################
# (c) Plot observed y vs estimated probabilities
###########################################################
phat <- fitted(fit.full)
# Save plot as PNG
png("HW10_plot.png", width = 1200, height = 700)
plot(phat,
jitter(dat$y, amount = 0.05),
xlab = "Estimated P(y = 1 | x)",
ylab = "Observed response y (0 = no fractures, 1 = ≥1 fracture)",
main = "Observed y vs. Estimated Probabilities",
pch  = 19)
abline(h = 0:1, lty = 2, col = "gray")
dev.off()
cat("=== (c) Plot saved as HW10_plot.png ===\n")
cat("--- Interpretation for (c) ---\n")
cat("• Points near 0 correspond to observed y=0.\n")
cat("• Points near 1 correspond to observed y=1.\n")
cat("• The model separates the groups extremely well.\n")
cat("• Consistent with low residual deviance = 14.04.\n\n")
###########################################################
# (d) logistic.display output
###########################################################
cat("=== (d) logistic.display Results ===\n")
print(logistic.display(fit.full))
cat("\n--- Interpretation for (d) ---\n")
cat("• Adjusted OR for x2 = 1.56 (CI 1.08–2.27), significant.\n")
cat("• ORs for x1, x3, x4 are NOT significant (CI includes 1).\n")
cat("• Strongest predictor of fractures = x2.\n\n")
###########################################################
# Additional Model Fit Statistics (R² & Pseudo-F)
###########################################################
cat("=== Additional Model Fit Statistics (R², Pseudo-F) ===\n")
# McFadden R2
mcfadden_R2 <- 1 - (fit.full$deviance / fit.full$null.deviance)
# Cox & Snell R2
cox_snell_R2 <- 1 - exp((fit.full$deviance - fit.full$null.deviance) / nrow(dat))
# Nagelkerke R2
nagelkerke_R2 <- cox_snell_R2 / (1 - exp(-fit.full$null.deviance / nrow(dat)))
# Tjur R2
tjur_R2 <- mean(phat[dat$y == 1]) - mean(phat[dat$y == 0])
# Pseudo-F statistic
LR <- fit.null$deviance - fit.full$deviance
df  <- length(coef(fit.full)) - 1
pseudo_F <- (LR/df) / (fit.full$deviance / (nrow(dat) - length(coef(fit.full))))
cat(sprintf("McFadden R2:      %.4f\n", mcfadden_R2))
cat(sprintf("Cox & Snell R2:   %.4f\n", cox_snell_R2))
cat(sprintf("Nagelkerke R2:    %.4f\n", nagelkerke_R2))
cat(sprintf("Tjur's R2:        %.4f\n", tjur_R2))
cat(sprintf("Pseudo F-statistic: %.4f\n\n", pseudo_F))
cat("--- Interpretation of R² ---\n")
cat("• McFadden R² near 0.7–1.0 indicates excellent fit.\n")
cat("• Tjur's R² measures separation of probabilities.\n")
cat("• These R² values confirm the model fits extremely well.\n")
# Close text output
sink()
###########################################################
# END OF FILE
