# ============================================================
# HW04 — Problem 3.8: CO2 Product vs Solvent & Hydrogen
# Name: RAJ SHAH
# Date: [Insert Date]
# ============================================================
# Set working directory
setwd("C:/Users/RAJ RUTGERS/Desktop/Regression Methods/HW04")
# Load dataset
b5 <- read.csv("B5.csv", stringsAsFactors = FALSE)
# y: CO2
# x6: Solvent total
# x7: Hydrogen consumption
# (a) Fit a multiple regression model: y ~ x6 + x7
cat("\n==== (a) Multiple Regression: y ~ x6 + x7 ====\n")
model_full <- lm(y ~ x6 + x7, data = b5)
summary(model_full)
# (b) Test significance of regression; R² and R²adj
cat("\n==== (b) ANOVA + R-squared ====\n")
anova(model_full)
cat("\nR-squared:", summary(model_full)$r.squared)
cat("\nAdjusted R-squared:", summary(model_full)$adj.r.squared, "\n")
# (c) t-tests for x6 and x7
cat("\n==== (c) t-Tests for Coefficients ====\n")
summary(model_full)$coefficients
# (d) 95% CI for β6 and β7
cat("\n==== (d) 95% CI for Coefficients ====\n")
confint(model_full, level = 0.95)
# (e) Fit model with only x6
cat("\n==== (e) Reduced Model: y ~ x6 only ====\n")
model_x6 <- lm(y ~ x6, data = b5)
summary(model_x6)
anova(model_x6)
cat("\nNew R-squared:", summary(model_x6)$r.squared)
cat("\nNew Adjusted R-squared:", summary(model_x6)$adj.r.squared, "\n")
# (f) 95% CI for β6 in reduced model
cat("\n==== (f) 95% CI for β6 (Reduced Model) ====\n")
confint(model_x6, level = 0.95)
# (g) Compare MSEs from both models
cat("\n==== (g) MSE Comparison ====\n")
mse_full <- mean(model_full$residuals^2)
mse_x6 <- mean(model_x6$residuals^2)
cat("\nMSE (full model):", mse_full)
cat("\nMSE (x6 only model):", mse_x6, "\n")
