# Display the model summary (coefficients, t-tests, R^2)
summary(lmod)
# --- (b) Test if spending is related to impressions ---------------------------
# 2: Is there a significant relationship between amount and retained impressions?
# Test H0: β1 = 0 vs H1: β1 ≠ 0 using the slope's t-test (from summary)
coef_table <- summary(lmod)$coefficients
slope_est  <- coef_table["amount","Estimate"]
slope_t    <- coef_table["amount","t value"]
slope_p    <- coef_table["amount","Pr(>|t|)"]
cat("\n--- Significance Test for Slope (β1) ---\n")
cat(sprintf("Slope estimate (β1_hat) = %.4f\n", slope_est))
cat(sprintf("t-statistic = %.4f\n", slope_t))
cat(sprintf("p-value = %.6f\n", slope_p))
cat("Decision at α = 0.05: ",
ifelse(slope_p < 0.05, "Reject H0 (significant relationship).",
"Fail to reject H0 (no significant relationship)."),
"\n")
# (Overall ANOVA for the regression)
