sink("HW03_output.txt")
cat("============================================================\n")
cat("HW03 — Problem 3.7: House Price Regression (y ~ x1 to x9)\n")
cat("Name: RAJ SHAH\n")
cat("============================================================\n\n")
# Load dataset
b4 <- read.csv("B4.csv", stringsAsFactors = FALSE)
# (a) Fit full model ------------------------------------------------------
cat("==== (a) Fit a multiple regression model with all variables ====\n")
cat("Model: y ~ x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9\n\n")
model_full <- lm(y ~ x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9, data = b4)
print(summary(model_full))
# (b) t-tests for significance of variables -------------------------------
cat("\n==== (b) Use t-tests to determine important predictors ====\n\n")
cat("t-tests (from summary above):\n")
print(coef(summary(model_full)))
# (c) 95% CI for β4 and β9 -----------------------------------------------
cat("\n==== (c) Construct 95% CI for β4 (x4) and β9 (x9) ====\n\n")
ci_c <- confint(model_full, c("x4", "x9"), level = 0.95)
print(ci_c)
# (d) Refit model without x4 and x9 --------------------------------------
cat("\n==== (d) Refit model without x4 and x9 ====\n")
cat("Model: y ~ x1 + x2 + x3 + x5 + x6 + x7 + x8\n\n")
model_reduced <- lm(y ~ x1 + x2 + x3 + x5 + x6 + x7 + x8, data = b4)
print(summary(model_reduced))
# (e) Compare models using R² and MSE -------------------------------------
cat("\n==== (e) Compare Full vs Reduced Model: R² and MSE ====\n\n")
r2_full <- summary(model_full)$r.squared
r2_reduced <- summary(model_reduced)$r.squared
mse_full <- mean(model_full$residuals^2)
mse_reduced <- mean(model_reduced$residuals^2)
cat(sprintf("Full model R²: %.4f\n", r2_full))
cat(sprintf("Reduced model R²: %.4f\n", r2_reduced))
cat(sprintf("MSE (full model): %.4f\n", mse_full))
cat(sprintf("MSE (reduced model): %.4f\n", mse_reduced))
# End sink
sink()
# (Optional) Residual plots into PDF
pdf("HW03_graphs.pdf")
hist(model_full$residuals, main = "Residuals: Full Model", col = "skyblue", xlab = "Residuals")
hist(model_reduced$residuals, main = "Residuals: Reduced Model", col = "lightgreen", xlab = "Residuals")
dev.off()
