# (You can also do seq(min(dat$amount), max(dat$amount), by=0.5))
newdf <- data.frame(amount = seq(0, 186, by = 0.5))
# Confidence band (mean response)
confband <- predict(lmod, newdata = newdf, interval = "confidence", level = 0.95)
newdfc <- cbind(newdf, confband)  # columns: amount, fit, lwr, upr
# Prediction band (new individual response)
predband <- predict(lmod, newdata = newdf, interval = "prediction", level = 0.95)
newdfp <- cbind(newdf, predband)  # columns: amount, fit, lwr, upr
# Plot: data, fitted line, 95% CI band (red), 95% PI band (blue)
plot(ret_impress ~ amount, data = dat_sorted,
pch = 19, cex = 1.0, col = "gray30",
xlab = "Amount Spent (millions USD)",
ylab = "Retained Impressions per Week (millions)",
main = "TV Ads: Amount vs Retained Impressions (with 95% Bands)")
# Fitted line
abline(lmod, lwd = 2)
# Add confidence band (dashed red)
lines(newdfc$amount, newdfc$lwr, col = "red", lty = 2)
lines(newdfc$amount, newdfc$upr, col = "red", lty = 2)
# Add prediction band (dashed blue)
lines(newdfp$amount, newdfp$lwr, col = "blue", lty = 2)
lines(newdfp$amount, newdfp$upr, col = "blue", lty = 2)
legend("bottomright",
legend = c("Data", "Fitted line", "95% Confidence band", "95% Prediction band"),
pch = c(19, NA, NA, NA),
lty = c(NA, 1, 2, 2),
col = c("gray30", "black", "red", "blue"),
bty = "n", lwd = c(NA, 2, 1, 1))
