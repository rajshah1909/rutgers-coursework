# =========================================================
# HW01  — Simple Linear Regression (SLR): Required Outputs
# Parts:
# (a) ANOVA table & test for significance of regression
# (b) 95% Confidence Interval on the slope
# (c) Percent of variability explained (R-squared in %)
# (d) Histogram of residuals (in PDF)
# =========================================================
options(stringsAsFactors = FALSE, scipen = 8, digits = 5, width = 120)
# ---- File path (edit if needed) ----
FILE_PATH <- "C:/Users/RAJ RUTGERS/Desktop/Regression Methods/HW01/p2_18.csv"
# ---- Load & prep ----
p2_18 <- read.csv(FILE_PATH)
stopifnot(all(c("amount", "ret_impress") %in% names(p2_18)))
p2_18 <- p2_18[order(p2_18$amount), ]
# ---- Fit SLR ----
lmod <- lm(ret_impress ~ amount, data = p2_18)
sm   <- summary(lmod)
# =========================================================
# Create REQUIRED FILE #1: HW01_output.txt (execution log)
# =========================================================
sink("HW01_output.txt")
cat("HW01 – Execution Log\n")
cat("Timestamp:", format(Sys.time(), "%Y-%m-%d %H:%M:%S"), "\n")
cat("Student: <Your Name Here>\n")
cat("Data file:", FILE_PATH, "\n\n")
cat("Model:\n")
print(lmod$call)
cat("\nModel Summary:\n")
print(sm)
# ---- (a) ANOVA & significance test ----
cat("\n=== Part (a): ANOVA table & test for significance of regression ===\n")
aov_tab <- anova(lmod)
print(aov_tab)
# F-test p-value (same as in the ANOVA table for the regression term)
F_val  <- aov_tab$`F value`[1]
df1    <- aov_tab$Df[1]
df2    <- aov_tab$Df[2]
p_val  <- pf(F_val, df1, df2, lower.tail = FALSE)
cat(sprintf("\nF statistic = %.4f (df = %d, %d), p-value = %.6g\n", F_val, df1, df2, p_val))
# ---- (b) 95% CI on the slope ----
cat("\n=== Part (b): 95% Confidence Interval on the slope (amount) ===\n")
ci <- confint(lmod, level = 0.95)  # 2 x 2 matrix with row names (Intercept, amount)
slope_ci <- ci["amount", ]
slope_est <- coef(lmod)["amount"]
cat(sprintf("Slope estimate (beta_1) = %.6f\n", slope_est))
cat(sprintf("95%% CI for slope: [%.6f, %.6f]\n", slope_ci[1], slope_ci[2]))
# ---- (c) Percent variability explained ----
cat("\n=== Part (c): Percent of total variability explained ===\n")
r2_pct <- 100 * sm$r.squared
cat(sprintf("R-squared = %.4f  ->  %.2f%%%% of variability explained by the SLR model\n",
sm$r.squared, r2_pct))
# ---- (d) Residuals histogram (note: see PDF file for the graphic) ----
cat("\n=== Part (d): Residuals histogram ===\n")
res_stats <- summary(residuals(lmod))
cat("Residuals summary (numeric):\n")
print(res_stats)
cat("Histogram is saved in HW01_plots.pdf\n")
# Session info for reproducibility
cat("\n--- Session Info ---\n")
print(sessionInfo())
sink()  # END of HW01_output.txt
# =========================================================
# Create REQUIRED FILE #2: HW01_plots.pdf (graphics only)
# =========================================================
pdf("HW01_plots.pdf")  # Each plotting call creates/uses a page
# (d) Residuals histogram (the only required plot per professor’s listing)
hist(residuals(lmod),
main = "HW01 (d): Residuals Histogram",
xlab = "Residuals",
breaks = "FD")
dev.off()  # END of HW01_plots.pdf
